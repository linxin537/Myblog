# ============================================================
# 生产环境配置文件
# 部署步骤: 复制此文件为 .env，修改所有含 "change-this" 的值
#   cp .env.production .env
#   # 编辑 .env，修改密码和域名
# ============================================================

# --- MySQL 数据库 (docker-compose 使用) ---
DB_ROOT_PASSWORD=change-this-root-password
DB_PASSWORD=change-this-user-password

# --- FastAPI 应用配置 ---
# 注意: DATABASE_URL 中的密码必须与上面的 DB_PASSWORD 一致
DATABASE_URL=mysql+aiomysql://blog_user:change-this-user-password@db:3306/blog_db
JWT_SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=/app/static/uploads
MAX_FILE_SIZE_MB=10
# 生产环境改为你的域名，多个用逗号分隔
CORS_ORIGINS=http://localhost,http://127.0.0.1
LOG_LEVEL=INFO
